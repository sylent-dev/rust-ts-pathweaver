   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Each row is one open decision; its three frames differ only by that decision (the rest stays at the first option).",
   "originalText": "Each row is one open decision; its three frames differ only by that decision (the rest stays at the first option).",
