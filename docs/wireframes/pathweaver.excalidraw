   "versionNonce": 1711467539,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "MAPPING LOOP: Drop Orb of Storms -> cast Spark through it -> Mana Tempest BEFORE scary packs (proactive, not panic) -> Sigil when you can preload -> keep moving.",
