// The website on Cloudflare: a Worker without code that serves the files of web/build
// (docs/cloudflare-usage.md). Uploaded by .github/workflows/deploy.yml at each merge into main.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pathweaver",
	// The date of the behaviours of the platform the Worker is made for; moved only on purpose.
	"compatibility_date": "2026-11-22",
	"assets": {
		"directory": "../web/build"
	},
	// One address, so that no copy of the website is found elsewhere: neither workers.dev nor the
	// address of each version, which turning off workers.dev alone doesn't turn off.
	"workers_dev": false,
	"preview_urls": false,
	// Cloudflare creates the DNS record and the certificate of the subdomain at the first deployment.
	"routes": [{ "pattern": "pathweaver.sylent.tools", "custom_domain": true }]
}
